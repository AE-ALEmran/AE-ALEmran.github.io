# Optional Cloud Sync Configuration (Supabase or Firebase)
# If left unset, the portfolio automatically operates using zero-config HTML5 LocalStorage!

# Supabase (PostgreSQL Cloud Backend)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Firebase (Optional Cloud Firestore Backend)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
